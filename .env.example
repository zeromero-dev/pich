# Copy to .env.local and fill in real values. See CLAUDE.md for details.

WEBSITE_URL=http://localhost:3000  # required in production — absolute origin baked into sitemap/JSON-LD/OG
# DEV_ORIGIN=xxx.ngrok-free.dev  # optional, dev only — tunnel host allowed to load /_next/static (never commit a real one)
HUGEPROFIT_API_KEY=                # server-only — HUGEPROFIT CRM auth token
CRM_WAREHOUSE_ID=51630             # required — warehouse the site sells from: 51630 (mock "dev") locally/Preview, 34998 in production
NOTION_TOKEN=                      # server-only — Notion integration secret; the integration must be added to the «Plai Pich — сайт» page
NOTION_EVENTS_DATA_SOURCE=         # «Події» data source id: database ••• → Manage data sources → Copy ID (not the database URL)
NOTION_ARTISTS_DATA_SOURCE=        # «Митці» data source id, same place
SYNC_KEY=                         # server-only — secret in the Notion «Оновити сайт» link (/api/update-site?key=…); not a CRM/Notion token
NOVA_POSHTA_API_KEY=              # optional, server-only — Nova Poshta cabinet → Settings → Security; lookups work keyless today (undocumented)

LIQPAY_PUBLIC_KEY=                 # server-only — LiqPay sandbox or live public key
LIQPAY_PRIVATE_KEY=                # server-only — never exposed to the client
LIQPAY_SANDBOX=1                   # "1" routes payments through LiqPay's sandbox; unset/"0" for live
