# Copy to .env.local and fill in real values. See CLAUDE.md for details.

WEBSITE_URL=http://localhost:3000  # required in production — absolute origin baked into sitemap/JSON-LD/OG
HUGEPROFIT_API_KEY=                # server-only — HUGEPROFIT CRM auth token
# CRM_WAREHOUSE_ID=51630           # optional — swings the catalog onto the mock "dev" warehouse. NEVER set in production.
GOOGLE_CALENDAR_API_KEY=           # server-only
GOOGLE_CALENDAR_ID=

LIQPAY_PUBLIC_KEY=                 # server-only — LiqPay sandbox or live public key
LIQPAY_PRIVATE_KEY=                # server-only — never exposed to the client
LIQPAY_SANDBOX=1                   # "1" routes payments through LiqPay's sandbox; unset/"0" for live
